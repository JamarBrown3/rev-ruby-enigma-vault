# Copy to .env and enter your real Atlas URI only in that ignored file.
# Keep Atlas's query options. URL-encode special characters in the password.
MONGODB_URI=
# Actual database name, not necessarily the Atlas cluster name.
MONGODB_DB_NAME=rev
# Separate from On the Fly, which uses 3001.
PORT=3002
# Frontend origin only (no path/trailing slash); update for deployment.
CLIENT_ORIGIN=http://localhost:5173
