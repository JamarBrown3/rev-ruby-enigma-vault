# Dependencies (applies inside client/, server/, and other subfolders)
node_modules/
.npm/
.pnpm-store/

# Secrets: keep real environment files out of Git
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Generated frontend builds and caches
dist/
dist-ssr/
.vite/
.cache/
.parcel-cache/
*.tsbuildinfo
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.eslintcache
.stylelintcache

# Logs, runtime files, and diagnostic reports
logs/
*.log
*.pid
*.pid.lock
.node_repl_history
report.[0-9]*.[0-9]*.[0-9]*.json

# Test outputs
coverage/
.nyc_output/
playwright-report/
test-results/

# Python analytics: environments, bytecode, and test caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# R session artifacts, if R is added later
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Local database data and generated reports (not source/seed data)
/server/data/db/
/server/reports/generated/
/analytics/reports/generated/

# Editor and operating-system files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Local hosting metadata
.netlify/
.vercel/

